# ==================== Development Environment ====================
# This file contains development-specific settings
# Copy this to .env for local development

# Application Settings
ENVIRONMENT=development
APP_NAME=EnerSight
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=DEBUG

# Security (Development - Change in Production!)
SECRET_KEY=dev-secret-key-change-in-production-12345678
JWT_SECRET=dev-jwt-secret-change-in-production-12345678
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Allow local development ports
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# InfluxDB Configuration (Local Development)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-dev-token-here
INFLUXDB_ORG=enersight
INFLUXDB_BUCKET=energy_data
INFLUXDB_TIMEOUT=10000

# PostgreSQL Configuration (Optional - Not required for basic functionality)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enersight
POSTGRES_USER=enersight_user
POSTGRES_PASSWORD=dev_password_123

# MQTT Configuration (Future use)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=energy/readings

# ML Model Configuration
ML_MODEL_PATH=ml/models
ML_MODEL_VERSION=1.0

# Logging
LOG_FILE=logs/app.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days
