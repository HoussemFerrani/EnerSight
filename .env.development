# ==================== Development Environment ====================
# Copy this to .env, then fill in the Supabase secrets (marked TODO).
# Real secrets must NEVER be committed — keep them only in your local .env.

# Application
ENVIRONMENT=development
APP_NAME=EnerSight
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=DEBUG

# Security — keep this >= 32 chars
SECRET_KEY=dev-secret-key-change-in-production-12345678

# CORS — local dev frontends
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ----- Supabase (backend) -----
# Project URL + keys: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx_or_legacy_anon_jwt
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx                       # TODO: from Settings → API
# JWT secret: Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=replace-with-project-jwt-secret           # TODO
JWT_ALGORITHM=HS256

# Pooler connection (port 6543). URL-encode special characters in the password.
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ----- Email alerts (SMTP) -----
# Required for alert email notifications. With Gmail, use an App Password:
#   Google Account → Security → 2-Step Verification → App passwords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com              # TODO
SMTP_PASSWORD=your-app-password                 # TODO
FROM_EMAIL=your-email@gmail.com                 # TODO
FROM_NAME=EnerSight Alerts

# ----- Reading simulator (no real sensors) -----
# Replays data/raw/Energy_consumption.csv into energy_readings as live data.
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=60

# ----- Alert monitor timing -----
# Window fills ~10 min after boot. At 60s readings (~78 kWh each) the 10-min
# window sums to ~780 kWh on average — tune alert_threshold_kwh to match.
# Alerts are edge-triggered: email when a problem STARTS, silent while it
# persists, re-armed when it clears. Cooldown is only an anti-flapping floor.
ALERT_CHECK_INTERVAL_SECONDS=60
ALERT_WINDOW_MINUTES=10
ALERT_COOLDOWN_MINUTES=5

# ----- MQTT (sensor ingestion) -----
# The backend subscribes to MQTT_TOPIC and persists messages to energy_readings.
# Publish with: python scripts/mqtt_simulator.py
# Needs a broker (e.g. mosquitto) on MQTT_BROKER; retries quietly if absent.
# When feeding via MQTT, set SIMULATOR_ENABLED=false to avoid double-counting.
MQTT_ENABLED=true
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=enersight/sensors/energy

# ML
ML_MODEL_PATH=ml/models
ML_MODEL_VERSION=1.0

# Logging
LOG_FILE=logs/app.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# ----- Frontend (Vite, read at build) -----
VITE_API_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx_or_legacy_anon_jwt
