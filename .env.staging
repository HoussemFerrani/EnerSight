# ==================== Staging Environment ====================
# This file contains staging-specific settings
# Mirror production settings but with staging resources

# Application Settings
ENVIRONMENT=staging
APP_NAME=EnerSight-Staging
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=DEBUG

# Security (Use different secrets from production)
SECRET_KEY=staging-secret-key-change-this-min-32-chars
JWT_SECRET=staging-jwt-secret-change-this-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Staging domain
CORS_ORIGINS=["https://staging.yourdomain.com","https://staging-app.yourdomain.com"]

# InfluxDB Configuration (Staging)
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=staging-token-here
INFLUXDB_ORG=enersight
INFLUXDB_BUCKET=energy_data_staging
INFLUXDB_TIMEOUT=10000

# PostgreSQL Configuration (Staging)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=enersight_staging
POSTGRES_USER=enersight_user
POSTGRES_PASSWORD=staging-password-here

# MQTT Configuration (Staging)
MQTT_BROKER=mqtt-staging.yourdomain.com
MQTT_PORT=1883
MQTT_USERNAME=enersight_mqtt
MQTT_PASSWORD=staging-mqtt-password
MQTT_TOPIC=energy/readings
MQTT_USE_TLS=false

# ML Model Configuration
ML_MODEL_PATH=ml/models
ML_MODEL_VERSION=1.0

# Logging
LOG_FILE=logs/app.log
LOG_ROTATION=20 MB
LOG_RETENTION=30 days

# Performance
WORKERS=2
MAX_CONNECTIONS=50
REQUEST_TIMEOUT=30
