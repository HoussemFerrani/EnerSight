# Environment Variables for EnerSight Platform

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Database - InfluxDB (Time Series)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-super-secret-token-here
INFLUXDB_ORG=enersight
INFLUXDB_BUCKET=energy_data

# Database - PostgreSQL (Metadata, Users)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enersight
POSTGRES_USER=enersight_user
POSTGRES_PASSWORD=your-postgres-password

# MQTT Broker
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=enersight/sensors/#
MQTT_USERNAME=
MQTT_PASSWORD=

# Machine Learning Models
ML_MODELS_PATH=ml/models/trained
MODEL_REGRESSION=regression_random_forest.joblib
MODEL_LSTM=lstm_energy_forecast.keras
MODEL_ANOMALY=anomaly_detector.joblib

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# Security (Generate secure keys for production!)
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET=your-jwt-secret-here

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/enersight.log
