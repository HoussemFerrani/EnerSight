# ==================== Production Environment ====================
# This file contains production-specific settings
# IMPORTANT: Update all sensitive values before deployment!

# Application Settings
ENVIRONMENT=production
APP_NAME=EnerSight
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Security (CRITICAL - CHANGE THESE VALUES!)
SECRET_KEY=CHANGE-THIS-TO-STRONG-SECRET-KEY-MIN-32-CHARS
JWT_SECRET=CHANGE-THIS-TO-STRONG-JWT-SECRET-MIN-32-CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Update with your production domain
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com","https://app.yourdomain.com"]

# InfluxDB Configuration (Production)
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=CHANGE-THIS-TO-YOUR-PRODUCTION-TOKEN
INFLUXDB_ORG=enersight
INFLUXDB_BUCKET=energy_data
INFLUXDB_TIMEOUT=10000

# PostgreSQL Configuration (Production)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=enersight_prod
POSTGRES_USER=enersight_user
POSTGRES_PASSWORD=CHANGE-THIS-TO-STRONG-PASSWORD

# MQTT Configuration (Production)
MQTT_BROKER=mqtt.yourdomain.com
MQTT_PORT=8883
MQTT_USERNAME=enersight_mqtt
MQTT_PASSWORD=CHANGE-THIS-TO-STRONG-PASSWORD
MQTT_TOPIC=energy/readings
MQTT_USE_TLS=true

# ML Model Configuration
ML_MODEL_PATH=ml/models
ML_MODEL_VERSION=1.0

# Logging
LOG_FILE=logs/app.log
LOG_ROTATION=50 MB
LOG_RETENTION=90 days

# Performance & Scaling
WORKERS=4
MAX_CONNECTIONS=100
REQUEST_TIMEOUT=30

# Monitoring (Optional)
SENTRY_DSN=
PROMETHEUS_ENABLED=true
